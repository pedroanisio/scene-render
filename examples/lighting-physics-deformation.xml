    <effect id="vignette" type="vignette" intensity="0.7" radius="1"/>
    <effect id="flare" type="lens-flare" intensity="0.8" radius="70"
            color="#FFE0A0FF"/>
  </effects>
  <physics fixedStep="0.008333333333333333" gravityX="0" gravityY="980.665"
