<?xml version="1.0"?>
<scene version="1.0">
  <project width="3840" height="2160" fps="30" duration="10" seed="424242"
           linearLight="true" background="#08101FFF" mode="standard"/>
  <output path="../build/lighting-physics-deformation.mp4" codec="h264"
          pixelFormat="yuv420p" preset="medium" crf="18"/>
  <assets>
    <text id="heading" text="PHYSICS + LIGHT" width="1500" height="150"
          size="105" color="#EAF4FFFF"/>
    <vector id="badge" shape="ellipse" width="320" height="320"
            fill="#38BDF8CC"/>
  </assets>
  <materials>
    <material id="gold" baseColor="#E9A52AFF" metallic="0.65"
              roughness="0.25" emissive="#120600FF"/>
    <material id="blue" baseColor="#3182CEFF" metallic="0.15"
              roughness="0.4" emissive="#00020AFF"/>
  </materials>
  <composition>
    <layer id="title" asset="heading" x="1170" y="100" blend="screen"/>
    <shape id="ground" shape="rect" width="3600" height="140"
           x="1920" y="1990" anchorX="1800" anchorY="70"
           fill="#26364FFF" stroke="#70A0CFFF" strokeWidth="8">
      <rigidBody type="static" shape="box" mass="1" friction="0.8"
                 restitution="0.15"/>
    </shape>
    <shape id="fallingBall" shape="ellipse" width="260" height="260"
           x="1550" y="460" anchorX="130" anchorY="130"
           fill="#FF5A7AFF" stroke="#FFFFFFFF" strokeWidth="8">
      <rigidBody type="dynamic" shape="circle" radius="130" mass="2"
                 friction="0.45" restitution="0.72" linearDamping="0.03"
                 velocityX="190" angularVelocity="40"/>
      <softBody mass="1" stiffness="18" damping="0.35" pressure="4"/>
      <deform>
        <modifier type="wave" amount="18" frequency="2" phase="0" axis="x">
          <animate property="amount" defaultInterpolation="ease-in-out">
            <key time="0" value="6"/>
            <key time="5" value="24"/>
            <key time="10" value="6"/>
          </animate>
        </modifier>
        <modifier type="squash" amount="0.08"/>
      </deform>
    </shape>
    <shape id="springBall" shape="rect" width="220" height="220"
