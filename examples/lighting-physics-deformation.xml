              x="650" y="750" z="0" radius="220" castShadow="true">
      <animate property="position.y" defaultInterpolation="ease-in-out">
        <key time="0" value="750"/>
        <key time="5" value="1050"/>
        <key time="10" value="750"/>
      </animate>
    </object3D>
    <object3D id="cube" primitive="box" material="blue"
              x="3200" y="1200" z="0" rotation="18" radius="180"
              castShadow="true"/>
  </composition>
  <lights>
    <light id="ambient" type="ambient" color="#B7D7FFFF" intensity="0.22"/>
    <light id="key" type="directional" color="#FFF0D2FF" intensity="1.2"
