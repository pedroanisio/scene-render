      <deform>
        <modifier type="bend" amount="60" axis="x"/>
        <modifier type="twist" amount="35"/>
      </deform>
    </shape>
    <layer id="deformedBadge" asset="badge" x="2800" y="500">
      <deform>
        <modifier type="stretch" amount="0.25"/>
        <modifier type="wave" amount="20" frequency="3" axis="y"/>
      </deform>
    </layer>
    <particleEmitter id="sparks" preset="sparks" x="1920" y="1180"
                     rate="90" lifetime="2.2" speed="650" spread="100"
                     size="8" color="#FFCC66EE" blend="add"/>
