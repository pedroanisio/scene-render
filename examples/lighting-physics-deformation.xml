    <forceField id="wind" type="directional" forceX="35" forceY="0"/>
    <forceField id="attractor" type="radial" x="1920" y="900"
                strength="1200" falloff="0.7"/>
    <constraint id="spring" type="spring" a="fallingBall" b="springBall"
                restLength="800" stiffness="8" damping="2"/>
  </physics>
</scene>
