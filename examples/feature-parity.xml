<?xml version="1.0" encoding="UTF-8"?>
<!-- Feature parity tour: group effects (drop-shadow, grade, 2D lighting)
     with animated parameters, color keyframes, parametric particles,
     mesh-warp, a pinned soft-body banner, vortex / pin / circle-on-box
     physics and shadow-mapped 3D with 2x supersampling. -->
<scene version="1.0">
  <project width="640" height="360" fps="30" duration="4" seed="20260925"
           background="#0A1020FF" antialias3d="2"/>
  <output path="../build/feature-parity.mp4" codec="h264" preset="veryfast" crf="20"/>
  <assets>
    <image id="checker" src="assets/checker.ppm" width="8" height="8"/>
  </assets>
  <materials>
    <material id="wallMat" baseColor="#8A94A8FF" roughness="0.9"/>
    <material id="cubeMat" baseColor="#3C78E6FF" metallic="0.1" roughness="0.4"/>
    <material id="orbMat" baseColor="#F0A040FF" metallic="0.5" roughness="0.3"/>
  </materials>
  <composition>
    <!-- 3D: a wall receiving shadow-mapped shadows of a cube and an orb. -->
    <object3D id="wall" primitive="plane" material="wallMat" x="520" y="250"
              z="-120" radius="95"/>
    <object3D id="cube" primitive="box" material="cubeMat" x="505" y="235"
              z="40" radius="24">
      <animate property="rotation">
        <key time="0" value="0"/><key time="4" value="90"/>
      </animate>
    </object3D>
    <object3D id="orb" primitive="sphere" material="orbMat" x="570" y="190"
              z="10" radius="20">
      <animate property="position.y" defaultInterpolation="ease-in-out">
        <key time="0" value="190"/><key time="2" value="215"/><key time="4" value="190"/>
      </animate>
    </object3D>

    <!-- Item 6: mesh-warp with an animated control point (offsets are in
         the layer's local pixels: the 8x8 checker is scaled 11x). -->
    <layer id="tile" asset="checker" x="25" y="25" scaleX="11" scaleY="11">
      <deform>
        <modifier type="mesh-warp" rows="3" cols="3">
          <point row="1" col="1" x="0" y="0">
            <animate property="x" defaultInterpolation="ease-in-out">
              <key time="0" value="-1.6"/><key time="2" value="1.6"/><key time="4" value="-1.6"/>
            </animate>
            <animate property="y">
              <key time="0" value="0"/><key time="2" value="-1.1"/><key time="4" value="0"/>
            </animate>
          </point>
          <point row="0" col="2" x="0.9" y="-0.5"/>
        </modifier>
      </deform>
    </layer>

    <!-- Items 1-4: a card group with its own drop-shadow and grade; the
         shadow offset and color animate, the card fill is keyed. -->
    <group id="card" x="150" y="28" effects="cardShadow cardGrade">
      <shape id="cardFace" shape="rect" width="130" height="78" fill="#F4F1DEFF"
             stroke="#E07A5FFF" strokeWidth="3">
        <animate property="fill" defaultInterpolation="ease-in-out">
          <key time="0" value="#F4F1DE"/><key time="2" value="#81B29A"/><key time="4" value="#F4F1DE"/>
        </animate>
      </shape>
      <shape id="cardDot" shape="ellipse" width="34" height="34" x="84" y="22"
             fill="#E07A5FFF"/>
    </group>

    <!-- Item 7: a banner pinned along its top edge, simulated as a
         mass-spring grid. -->
    <shape id="banner" shape="rect" width="100" height="70" x="320" y="22"
           fill="#F2CC8FFF" stroke="#3D405BFF" strokeWidth="3">
      <animate property="stroke">
        <key time="0" value="#3D405B"/><key time="4" value="#E07A5F"/>
      </animate>
      <softBody mass="2" stiffness="7" damping="0.25" pressure="2" rows="4" cols="6"
                pin="top"/>
    </shape>

    <!-- Items 1-3: 2D lighting with relief over a group of shapes. -->
    <group id="litPanel" effects="panelLight">
      <shape id="knobA" shape="ellipse" width="64" height="64" x="30" y="145" fill="#E8E8E8FF"/>
      <shape id="knobB" shape="ellipse" width="64" height="64" x="110" y="145" fill="#E8E8E8FF"/>
      <shape id="knobC" shape="rect" width="64" height="64" x="190" y="145" fill="#E8E8E8FF"/>
    </group>

    <!-- Item 8: physics. A floor and a platform (static boxes), a ball
         dropped near the platform's end (exact circle/box contact), a pinned
         pendulum and a small box caught by an animated vortex. -->
    <shape id="floor" shape="rect" width="640" height="16" x="320" y="352"
           anchorX="320" anchorY="8" fill="#243B55FF">
      <rigidBody type="static" friction="0.8"/>
    </shape>
    <shape id="platform" shape="rect" width="120" height="14" x="300" y="300"
           anchorX="60" anchorY="7" fill="#3D5A80FF">
      <rigidBody type="static" friction="0.6"/>
    </shape>
    <shape id="ball" shape="ellipse" width="24" height="24" x="350" y="230"
           anchorX="12" anchorY="12" fill="#EE6C4DFF">
      <rigidBody shape="circle" radius="12" restitution="0.3" friction="0.4"/>
    </shape>
    <shape id="bob" shape="ellipse" width="22" height="22" x="420" y="150"
           anchorX="11" anchorY="11" fill="#98C1D9FF">
      <rigidBody shape="circle" radius="11" linearDamping="0"/>
    </shape>
    <shape id="spinner" shape="rect" width="16" height="16" x="140" y="260"
           anchorX="8" anchorY="8" fill="#C77DFFFF">
      <rigidBody linearDamping="0.2" angularVelocity="90"/>
    </shape>

    <!-- Item 5: parametric particles (no preset) with emission-time
         animation, and a smoke preset with explicit overrides. -->
    <particleEmitter id="fountain" x="240" y="344" direction="-90" spread="18"
                     speed="210" speedVariance="40" gravityY="260" size="3"
                     sizeEnd="0.6" color="#FFE070FF" colorEnd="#FF402000"
                     lifetime="1.3" lifetimeVariance="0.3" maxParticles="400"
                     emitterWidth="16" blend="add">
      <animate property="rate">
        <key time="0" value="20"/><key time="2" value="140"/><key time="4" value="40"/>
      </animate>
      <animate property="direction" defaultInterpolation="ease-in-out">
        <key time="0" value="-110"/><key time="2" value="-70"/><key time="4" value="-110"/>
      </animate>
    </particleEmitter>
    <particleEmitter id="smoke" preset="smoke" x="80" y="344" rate="10" lifetime="2"
                     speed="40" spread="12" size="4" color="#B8C4D6AA" blend="screen"/>
    <particleEmitter id="confetti" x="560" y="20" rate="18" lifetime="3" direction="90"
                     spread="50" speed="35" gravityY="25" size="2.5" shape="square"
                     emitterWidth="120" color="#FFFFFFFF" colorEnd="#FFFFFF00">
      <animate property="color">
        <key time="0" value="#FF5D8F"/><key time="2" value="#5DD9FF"/><key time="4" value="#FF5D8F"/>
      </animate>
    </particleEmitter>
  </composition>
  <lights>
    <!-- 3D lights: shadow maps for the directional and spot lights. -->
    <light id="amb3d" type="ambient" color="#C8D8FFFF" intensity="0.15"/>
    <light id="sun3d" type="directional" color="#FFF2DCFF" intensity="0.7"
           yaw="-22" pitch="12" castShadow="true" shadowMapSize="1024"/>
    <light id="spot3d" type="spot" color="#FF8FC8FF" intensity="0.5" x="600" y="300"
           z="220" spotAngle="40" range="600" falloff="1" castShadow="true"
           shadowMapSize="512"/>
    <!-- 2D lights, referenced by the panelLight effect (x/y in pixels). -->
    <light id="fill2d" type="ambient" color="#8090B0FF" intensity="0.18"/>
    <light id="lamp2d" type="point" x="150" y="140" z="70" range="230" intensity="1.3">
      <animate property="color">
        <key time="0" value="#FFD08A"/><key time="2" value="#8AD0FF"/><key time="4" value="#FFD08A"/>
      </animate>
      <animate property="position.x" defaultInterpolation="ease-in-out">
        <key time="0" value="40"/><key time="2" value="260"/><key time="4" value="40"/>
      </animate>
    </light>
    <light id="beam2d" type="spot" x="10" y="280" z="40" yaw="-35" spotAngle="40"
           range="320" intensity="0.7" color="#FF6FA0FF"/>
  </lights>
  <effects>
    <effect id="cardShadow" type="drop-shadow" offsetY="10" radius="6" intensity="0.7">
      <animate property="offsetX">
        <key time="0" value="4"/><key time="2" value="16"/><key time="4" value="4"/>
      </animate>
      <animate property="color">
        <key time="0" value="#000000"/><key time="2" value="#102A60"/><key time="4" value="#000000"/>
      </animate>
    </effect>
    <effect id="cardGrade" type="color-grade" saturation="1.2" contrast="1.1">
      <animate property="brightness">
        <key time="0" value="0"/><key time="2" value="0.06"/><key time="4" value="0"/>
      </animate>
    </effect>
    <effect id="panelLight" type="lighting" lights="fill2d lamp2d beam2d"
            falloff="smooth" relief="5"/>
    <!-- Unreferenced effects keep their whole-frame role. -->
    <effect id="frameGlow" type="glow" intensity="0.35" radius="3" threshold="0.75"/>
    <effect id="frameVignette" type="vignette" intensity="0.45"/>
  </effects>
  <physics fixedStep="0.008333333333333333" gravityY="320">
    <forceField id="swirl" type="vortex" x="140" y="240" falloff="1.2">
      <animate property="strength">
        <key time="0" value="0"/><key time="1" value="9000"/><key time="4" value="9000"/>
      </animate>
    </forceField>
    <forceField id="breeze" type="directional">
      <animate property="forceX" defaultInterpolation="ease-in-out">
        <key time="0" value="0"/><key time="1.5" value="90"/><key time="3" value="-60"/>
        <key time="4" value="0"/>
      </animate>
    </forceField>
    <constraint id="hinge" type="pin" a="bob" x="380" y="150"/>
  </physics>
</scene>
