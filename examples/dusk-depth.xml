<?xml version="1.0" encoding="UTF-8"?>
<!-- The dusk mountain range of dusk-parallax.xml rebuilt with depth cards:
     every plane only declares its depth and one camera moves (truck, dolly,
     late yaw). Parallax, depth scaling, perspective, and the occlusion of
     the 3D beacon between the ridge and the forest follow from the camera.
     Camera at z = -1000 with zoom 1000, so a plane at depth d is drawn with
     scale (1000 + d) / 1000 about the frame center to appear at its pixel
     size when the camera is at rest. Adjacent tiles overlap by 2 px so their
     anti-aliased edges do not leave a seam. Art: "Mountain at Dusk" by ansimuz and
     fog by GrumpyDiamond, both CC0 (assets/third-party/dusk-parallax). -->
<scene version="1.0">
  <project width="1920" height="1080" fps="30" duration="8" seed="20260925"
           linearLight="true" workingColorSpace="srgb" background="#000000FF"
           mode="standard"/>
  <output path="../build/dusk-depth.mp4" codec="h264" pixelFormat="yuv420p"
          preset="medium" crf="18" colorSpace="srgb" colorRange="limited"/>
  <assets>
    <image id="sky" src="../assets/third-party/dusk-parallax/sky.png"
           width="2176" height="1280" colorSpace="srgb"/>
    <image id="farPeaks" src="../assets/third-party/dusk-parallax/far-peaks.png"
           width="1904" height="1120" colorSpace="srgb"/>
    <image id="mountains" src="../assets/third-party/dusk-parallax/mountains.png"
           width="3808" height="1120" colorSpace="srgb"/>
    <image id="forest" src="../assets/third-party/dusk-parallax/forest.png"
           width="3808" height="1120" colorSpace="srgb"/>
    <image id="foreground" src="../assets/third-party/dusk-parallax/foreground.png"
           width="3808" height="1120" colorSpace="srgb"/>
    <image id="fog" src="../assets/third-party/dusk-parallax/original/fog.png"
           width="1475" height="704" colorSpace="srgb"/>
    <text id="titleText" text="Depth cards" width="640" height="130" size="100"
          color="#FFF6EEFF" fontFile="../assets/third-party/inter/Inter-SemiBold.ttf"/>
    <text id="subText" text="one camera · every plane at its own depth"
          width="760" height="60" size="38" color="#FFD48AFF"
          fontFile="../assets/third-party/inter/Inter-Regular.ttf"/>
    <mesh id="gem" src="assets/octahedron.obj"/>
  </assets>
  <materials>
    <material id="beacon" baseColor="#7FE8FFFF" metallic="0.4" roughness="0.25"
              emissive="#0C3A48FF"/>
  </materials>
  <composition>
    <camera id="cam" x="0" y="0" z="-1000" zoom="1000" near="1" far="100000"
            focusDistance="1000" aperture="2">
      <animate property="position.x" defaultInterpolation="ease-in-out">
        <key time="0" value="0"/><key time="8" value="900"/>
      </animate>
      <animate property="position.z" defaultInterpolation="ease-in-out">
        <key time="0" value="-1000"/><key time="8" value="-900"/>
      </animate>
      <animate property="yaw" defaultInterpolation="ease-in-out">
        <key time="0" value="0"/><key time="5" value="0"/><key time="8" value="3"/>
      </animate>
    </camera>

    <group id="skyPlane" depth="39000" x="960" y="540" anchorX="960" anchorY="540"
           scaleX="40" scaleY="40">
      <layer id="sky0" asset="sky" x="-640" y="-100"/>
      <layer id="sky1" asset="sky" x="1534" y="-100"/>
    </group>
    <group id="farPlane" depth="9000" x="960" y="540" anchorX="960" anchorY="540"
           scaleX="10" scaleY="10">
      <layer id="far0" asset="farPeaks" x="-60" y="-40"/>
      <layer id="far1" asset="farPeaks" x="1842" y="-40"/>
      <layer id="far2" asset="farPeaks" x="3744" y="-40"/>
    </group>
    <group id="fogFar" depth="5000" x="960" y="540" anchorX="960" anchorY="540"
           scaleX="6" scaleY="6" blend="screen" opacity="0.3">
      <layer id="fogFar0" asset="fog" x="-500" y="280" scaleX="1.3" scaleY="1"/>
      <layer id="fogFar1" asset="fog" x="1300" y="260" scaleX="1.3" scaleY="1"/>
    </group>
    <group id="ridgePlane" depth="3000" x="960" y="540" anchorX="960" anchorY="540"
           scaleX="4" scaleY="4">
      <layer id="ridge0" asset="mountains" x="-80" y="-40"/>
      <layer id="ridge1" asset="mountains" x="3726" y="-40"/>
    </group>
    <object3D id="beaconGem" primitive="mesh" mesh="gem" material="beacon"
              x="1248" y="300" z="2200" radius="260" rotationX="-15">
      <animate property="rotation.y" defaultInterpolation="linear">
        <key time="0" value="0"/><key time="8" value="360"/>
      </animate>
      <!-- Sinks behind the nearer forest card and rises again. -->
      <animate property="position.y" defaultInterpolation="ease-in-out">
        <key time="0" value="300"/><key time="4" value="-700"/><key time="8" value="300"/>
      </animate>
    </object3D>
    <group id="fogNear" depth="2000" x="960" y="540" anchorX="960" anchorY="540"
           scaleX="3" scaleY="3" blend="screen" opacity="0.26">
      <layer id="fogNear0" asset="fog" x="-600" y="420" scaleX="1.5" scaleY="1.1"/>
      <layer id="fogNear1" asset="fog" x="1400" y="440" scaleX="1.5" scaleY="1.1"/>
    </group>
    <group id="forestPlane" depth="800" x="960" y="540" anchorX="960" anchorY="540"
           scaleX="1.8" scaleY="1.8">
      <layer id="forest0" asset="forest" x="-80" y="-40"/>
      <layer id="forest1" asset="forest" x="3726" y="-40"/>
      <particleEmitter id="flies0" preset="dust" x="700" y="930" rate="3"
                       lifetime="3.5" speed="110" spread="180" size="3.4"
                       color="#FFE9A8E6" blend="add"/>
      <particleEmitter id="flies1" preset="dust" x="1500" y="960" rate="3"
                       lifetime="3.5" speed="110" spread="180" size="3.4"
                       color="#FFE9A8E6" blend="add"/>
      <particleEmitter id="flies2" preset="dust" x="2300" y="900" rate="3"
                       lifetime="3.5" speed="110" spread="180" size="3.4"
                       color="#FFE9A8E6" blend="add"/>
    </group>
    <group id="foregroundPlane" depth="0">
      <layer id="fg0" asset="foreground" x="-80" y="-40"/>
      <layer id="fg1" asset="foreground" x="3726" y="-40"/>
    </group>
    <!-- Nearer than the camera rest plane: magnified 1000 / 750, so its
         scale and position compensate to land at (560, 470), over the ridge. -->
    <group id="title" depth="-250" rotationY="-14" x="660" y="487.5"
           scaleX="0.75" scaleY="0.75" start="0.4" end="6.4">
      <animate property="opacity" defaultInterpolation="ease-in-out">
        <key time="0.4" value="0"/><key time="1.4" value="1"/>
        <key time="5.4" value="1"/><key time="6.4" value="0"/>
      </animate>
      <layer id="titleL" asset="titleText" x="0" y="0"/>
      <layer id="subL" asset="subText" x="6" y="130"/>
    </group>
  </composition>
  <lights>
    <light id="ambient" type="ambient" color="#C8B8FFFF" intensity="0.25"/>
    <light id="key" type="directional" color="#FFE2C8FF" intensity="1.2"
           yaw="-35" pitch="-25"/>
  </lights>
  <effects>
    <effect id="bloom" type="bloom" intensity="0.3" radius="10" threshold="0.8"/>
    <effect id="vignette" type="vignette" intensity="0.4" radius="1"/>
  </effects>
</scene>
