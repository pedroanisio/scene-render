<?xml version="1.0" encoding="UTF-8"?>
<!-- B1-3 fixture: every flattened operator, advanced mask attribute, track
     matte mode and adjustment construct in one small 1.1 scene. Used by the
     loader/render allocation-failure replays and the capability coverage. -->
<scene version="1.1">
  <project width="64" height="48" fps="4" duration="2" seed="21"
           background="#18202C"/>
  <composition>
    <group id="ops" x="2" y="2">
      <shape id="base" shape="rect" width="28" height="20" fill="#E0A060"/>
      <shape id="st" shape="ellipse" x="2" y="2" width="12" height="10"
             fill="#FFFFFFC0" blend="stencil-alpha"/>
      <shape id="sl" shape="ellipse" x="14" y="2" width="12" height="10"
             fill="#80808080" blend="stencil-luma"/>
      <shape id="si" shape="rect" x="4" y="12" width="6" height="6"
             fill="#FFFFFF" blend="silhouette-alpha"/>
      <shape id="su" shape="rect" x="12" y="12" width="6" height="6"
             fill="#C0C0C0" blend="silhouette-luma"/>
      <shape id="aa" shape="rect" x="18" y="10" width="8" height="8"
             fill="#2060E080" blend="alpha-add"/>
      <shape id="be" shape="rect" x="-2" y="-2" width="32" height="24"
             fill="#304050" blend="behind"/>
    </group>
    <shape id="dz" shape="ellipse" x="34" y="2" width="28" height="20"
           fill="#D059B9A0" blend="dissolve">
      <animate property="opacity"><key time="0" value=".4"/>
        <key time="2" value="1"/></animate>
    </shape>
    <shape id="masked" shape="rect" x="2" y="26" width="20" height="20" fill="#F0D040">
      <mask type="star" x="10" y="10" radius="9" innerRadius="4" points="5"
            feather="1.5" opacity=".9"/>
      <mask type="polygon" x="10" y="10" radius="6" points="6" mode="subtract"
            expansion="-1"/>
      <mask type="path" path="M 0 0 L 8 0 L 0 8 Z" mode="add" fillRule="evenodd"
            width="6" height="6"/>
      <mask type="ellipse" x="14" y="14" width="6" height="6" mode="lighten"/>
      <mask type="rect" width="20" height="4" mode="darken" invert="true"/>
      <mask type="rounded-rect" x="2" y="2" width="16" height="16" radius="3"
            mode="difference">
        <animate property="expansion"><key time="0" value="0"/>
          <key time="2" value="2.5"/></animate>
      </mask>
      <mask type="rect" width="4" height="4" mode="none"/>
    </shape>
    <shape id="src" shape="ellipse" x="24" y="26" width="18" height="18"
           fill="#FFFFFFD0">
      <animate property="position.x"><key time="0" value="24"/>
        <key time="2" value="30"/></animate>
    </shape>
    <shape id="ma" shape="rect" x="24" y="26" width="9" height="9" fill="#40E080"
           matte="src"/>
    <shape id="mi" shape="rect" x="33" y="26" width="9" height="9" fill="#E04080"
           matte="src" matteMode="alpha-inverted"/>
    <shape id="ml" shape="rect" x="24" y="35" width="9" height="9" fill="#4080E0"
           matte="src" matteMode="luma"/>
    <shape id="mn" shape="rect" x="33" y="35" width="9" height="9" fill="#E0E040"
           matte="src" matteMode="luma-inverted" matteVisible="true"/>
    <adjustment id="adj" effects="soft grey" x="44" y="26" opacity=".85"
                blend="normal" matte="lens" matteMode="alpha" skewX="4">
      <mask type="rect" width="18" height="20" feather="1"/>
      <animate property="opacity"><key time="0" value=".5"/>
        <key time="2" value="1"/></animate>
    </adjustment>
    <shape id="lens" shape="ellipse" x="44" y="26" width="18" height="20"
           fill="#FFFFFF" z="-1"/>
    <adjustment id="warm" effects="grey" blend="multiply" z="2" start=".5"/>
    <shape id="viaadj" shape="rect" x="0" y="0" width="64" height="4"
           fill="#FFFFFF" matte="warm" z="3"/>
  </composition>
  <effects>
    <effect id="soft" type="blur" radius="2"/>
    <effect id="grey" type="color-grade" saturation="0.2" brightness="0.05"/>
  </effects>
</scene>
