<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixed benchmark for scripts/perf-check.py and scripts/profile.sh.
     Exercises every timed stage (3D lighting, 2D compositing with groups,
     masks, blends, video, vectors, particles and physics, 360 viewport,
     every post effect) using only committed assets. Changing this file
     invalidates benchmarks/baseline.json; refresh it with
     scripts/perf-check.py with the update flag. -->
<scene version="1.0">
  <project width="1280" height="720" fps="30" duration="1" seed="4242"
           linearLight="true" background="#0B1222FF" mode="viewport"/>
  <output path="../build/perf-scene.mkv" codec="ffv1" pixelFormat="yuv444p"/>
  <assets>
    <image id="checker" src="../examples/assets/checker.ppm" width="8" height="8"/>
    <video id="clip" src="../examples/assets/clip.mp4" width="160" height="90"
           fps="12" duration="2"/>
    <vector id="ribbon" shape="path" width="260" height="180"
            path="M 15 90 C 55 5 110 5 130 68 C 150 5 205 5 245 90 C 205 165 155 165 130 112 C 105 165 55 165 15 90 Z"
            fill="#FF4D8DDE"/>
    <mesh id="gemMesh" src="../examples/assets/octahedron.obj"/>
  </assets>
  <materials>
    <material id="gemMat" baseColor="#5DE4FFFF" metallic="0.45" roughness="0.2"
              emissive="#031322FF"/>
    <material id="gold" baseColor="#E9A52AFF" metallic="0.65" roughness="0.25"/>
  </materials>
  <scene360 layout="equirectangular" width="1920" height="960"
            viewportCamera="tour"/>
  <composition>
    <!-- Inactive so 3D stays in panorama pixel space; selected by id. -->
    <camera id="tour" active="false" projection="perspective" yaw="-20"
            pitch="0" roll="0" fov="80">
      <animate property="yaw" defaultInterpolation="linear">
        <key time="0" value="-20"/><key time="1" value="20"/>
      </animate>
    </camera>
    <layer id="panorama" asset="checker" scaleX="240" scaleY="120" opacity="0.35"/>
    <object3D id="orb" primitive="sphere" material="gold" x="760" y="520" z="0"
              radius="120" castShadow="true"/>
    <object3D id="cube" primitive="box" material="gemMat" x="1180" y="560" z="0"
              radius="90" rotation="20" castShadow="true"/>
    <object3D id="gem" primitive="mesh" mesh="gemMesh" material="gemMat"
              x="960" y="360" z="0" radius="110" castShadow="true">
      <animate property="rotation.y" defaultInterpolation="linear">
        <key time="0" value="0"/><key time="1" value="120"/>
      </animate>
    </object3D>
    <group id="cards" x="620" y="220">
      <mask type="rounded-rect" x="0" y="0" width="680" height="300" radius="40"/>
      <layer id="clipA" asset="clip" x="0" y="0" scaleX="2" scaleY="2" loop="3"/>
      <layer id="clipB" asset="clip" x="340" y="0" scaleX="2" scaleY="2"
             loop="3" reverse="true" blend="screen" opacity="0.8"/>
      <layer id="ribbonA" asset="ribbon" x="200" y="100" blend="add">
        <deform>
          <modifier type="wave" amount="10" frequency="2" phase="0" axis="y">
            <animate property="phase" defaultInterpolation="linear">
              <key time="0" value="0"/><key time="1" value="6.283185307"/>
            </animate>
          </modifier>
        </deform>
      </layer>
    </group>
    <group id="grid" x="560" y="560">
      <shape id="g00" shape="ellipse" width="60" height="60" x="0" y="0" fill="#38BDF8CC" blend="screen"/>
      <shape id="g01" shape="rect" width="60" height="60" x="70" y="0" rotation="15" fill="#F472B6CC" blend="add"/>
      <shape id="g02" shape="ellipse" width="60" height="60" x="140" y="0" fill="#A3E635CC" blend="multiply"/>
      <shape id="g03" shape="rect" width="60" height="60" x="210" y="0" rotation="30" fill="#FACC15CC" stroke="#FFFFFFFF" strokeWidth="4"/>
      <shape id="g04" shape="ellipse" width="60" height="60" x="280" y="0" fill="#F87171CC" blend="overlay"/>
      <shape id="g05" shape="rect" width="60" height="60" x="350" y="0" rotation="45" fill="#818CF8CC" blend="difference"/>
      <shape id="g06" shape="ellipse" width="60" height="60" x="420" y="0" fill="#2DD4BFCC" blend="screen"/>
      <shape id="g07" shape="rect" width="60" height="60" x="490" y="0" rotation="60" fill="#FB923CCC" blend="add"/>
      <shape id="g08" shape="ellipse" width="60" height="60" x="560" y="0" fill="#E879F9CC"/>
      <shape id="g09" shape="rect" width="60" height="60" x="630" y="0" rotation="75" fill="#94A3B8CC" blend="screen"/>
    </group>
    <shape id="floor" shape="rect" width="1600" height="40" x="960" y="900"
           anchorX="800" anchorY="20" fill="#26364FFF">
      <rigidBody type="static" shape="box" mass="1" friction="0.8" restitution="0.3"/>
    </shape>
    <shape id="ballA" shape="ellipse" width="80" height="80" x="500" y="620"
           anchorX="40" anchorY="40" fill="#FF5A7AFF">
      <rigidBody type="dynamic" shape="circle" radius="40" mass="1" restitution="0.7" velocityX="120"/>
    </shape>
    <shape id="ballB" shape="ellipse" width="60" height="60" x="1400" y="600"
           anchorX="30" anchorY="30" fill="#7EE787FF">
      <rigidBody type="dynamic" shape="circle" radius="30" mass="1" restitution="0.7" velocityX="-150"/>
    </shape>
    <particleEmitter id="sparks" preset="sparks" x="960" y="700" rate="200"
                     lifetime="1" speed="400" spread="120" size="4"
                     color="#FFCC66EE" blend="add"/>
    <particleEmitter id="dust" preset="dust" x="700" y="400" rate="60"
                     lifetime="2" speed="120" spread="360" size="3"
                     color="#CFE0FFAA" blend="screen"/>
  </composition>
  <lights>
    <light id="ambient" type="ambient" color="#B4CEFFFF" intensity="0.16"/>
    <light id="key" type="directional" color="#FFFFFFFF" intensity="1.2"
           yaw="-35" pitch="30" castShadow="true"/>
    <light id="rim" type="point" color="#FF4DB8FF" intensity="2.0"
           x="1300" y="300" z="300" range="900" falloff="1.5"/>
    <light id="spot" type="spot" color="#66CCFFFF" intensity="1.5"
           x="600" y="200" z="600" yaw="25" pitch="-20" range="1400"
           falloff="1.2" spotAngle="45"/>
  </lights>
  <effects>
    <effect id="glow" type="glow" intensity="0.3" radius="6" threshold="0.6"/>
    <effect id="bloom" type="bloom" intensity="0.5" radius="10" threshold="0.65"/>
    <effect id="blur" type="blur" intensity="0.2" radius="3"/>
    <effect id="flare" type="lens-flare" intensity="0.6" radius="60" color="#FFE0A0FF"/>
    <effect id="grade" type="color-grade" intensity="0.8" saturation="1.1"
            contrast="1.05" brightness="0.01"/>
    <effect id="vignette" type="vignette" intensity="0.6" radius="1"/>
  </effects>
  <physics fixedStep="0.004166666666666667" gravityX="0" gravityY="980"/>
</scene>
